# Runtime config (required on server + local — NOT in git; create from *.example after deploy/clone)
/config.php
/config.local.php
/config.local.production.php
/config.infinityfree.php
/config.*.local.php
/config.php.bak
/config.local.php.bak
/config.local.production.php.bak
# Config templates (site root keeps only config.php.example for deploy reference):
!/config.php.example
# Local/production/InfinityFree templates live under docs/config-examples/ (omit docs/ from host zip if desired)

# Composer dependencies — installed by the host on deploy (composer install)
/vendor/

# Property uploads: HouGarden AU uses uploads/properties/hg-{id}/ only.
# Legacy Colorado / cc-* demo folders are not tracked.
/uploads/properties/*
!/uploads/properties/.gitkeep
!/uploads/properties/hg-*/
!/uploads/properties/hg-*/**

/uploads/branding/*
!/uploads/branding/.gitkeep
!/uploads/branding/.htaccess

/uploads/regions/*
!/uploads/regions/.gitkeep
!/uploads/regions/.htaccess
!/uploads/regions/*.jpg
!/uploads/regions/*.jpeg
!/uploads/regions/*.png
!/uploads/regions/*.webp

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs / rate limits
/storage/logs/*
!/storage/logs/.gitkeep
/storage/rate_limits/*
!/storage/rate_limits/.gitkeep
